# =============================================================================
# .env.example — copie para .env e ajuste. NUNCA versione o .env real.
#   cp .env.example .env
# Todas as variáveis abaixo têm defaults em config/defaults.env; aqui ficam
# apenas as que você provavelmente quer sobrescrever por máquina/laboratório.
# =============================================================================

# --- Autorização (obrigatório para executar qualquer ferramenta) -------------
# Deve ser exatamente YES. Sem isso, todo script recusa a execução.
AUTHORIZED_SECURITY_TESTING=NO

# Reforço extra exigido pelo perfil aggressive (ambiente descartável/isolado).
DANGEROUS_ACK=NO

# --- Escopo e alvos ----------------------------------------------------------
SCOPE_FILE=./config/scope.txt
TARGETS_FILE=./config/targets.txt

# --- Perfil de agressividade -------------------------------------------------
# safe | standard | aggressive | custom
PROFILE=safe

# --- Ferramentas (caminhos ou nomes no PATH) ---------------------------------
SQLMAP_BIN=sqlmap
FFUF_BIN=ffuf
DALFOX_BIN=dalfox
XSSTRIKE_BIN=xsstrike

# --- Wordlists (localizadas, nunca baixadas automaticamente) -----------------
SECLISTS_DIR=/opt/SecLists
PAYLOADS_ALL_THE_THINGS_DIR=/opt/PayloadsAllTheThings
FUZZDB_DIR=/opt/fuzzdb
CUSTOM_WORDLIST_DIR=./wordlists/custom

# --- SQLi por wordlist no ffuf-sqli-sweep.sh -------------------------------
# O sweep injeta cada entrada da lista no parametro de consulta abaixo.
# FFUF_VALUE_PARAM=id
# FFUF_SQLI_RAW_WORDLIST=./wordlists/custom/sqli.txt

# --- Coletor local para callbacks (blind XSS etc.) ---------------------------
# Deve apontar exclusivamente para um coletor local e estar dentro do escopo.
ALLOW_LOCAL_BLIND_XSS=NO
LOCAL_BLIND_XSS_CALLBACK=

# --- Segredos (prefira arquivos 0600 fora do Git; não coloque valores aqui) --
# COOKIE_FILE=./config/cookies.txt
# HEADERS_FILE=./config/headers.txt

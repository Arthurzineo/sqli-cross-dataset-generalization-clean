# =============================================================================
# profiles/standard.env — volume intermediário para coleta regular.
# =============================================================================
PROFILE_NAME=standard

MAX_PARALLEL_JOBS=2
THREADS=4
REQUEST_RATE=0
DELAY_MS=0

SQLMAP_LEVEL=3
SQLMAP_RISK=2
SQLMAP_TECHNIQUE=BEUST
RUN_TAMPERS=1
RUN_CRAWL=1
MAX_CRAWL_DEPTH=2
MAX_CRAWL_URLS=1000

RUN_ENUM=0
RUN_DUMP=0
ALLOW_METADATA_ENUMERATION=NO
ALLOW_LOCAL_BLIND_XSS=NO

HTTP_TIMEOUT=30
MAX_JOB_SECONDS=3600

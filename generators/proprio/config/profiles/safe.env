# =============================================================================
# profiles/safe.env — baixo volume e baixa concorrência. Padrão recomendado.
# =============================================================================
PROFILE_NAME=safe

# Concorrência reduzida
MAX_PARALLEL_JOBS=1
THREADS=2
REQUEST_RATE=5
DELAY_MS=200

# Cobertura conservadora
SQLMAP_LEVEL=1
SQLMAP_RISK=1
SQLMAP_TECHNIQUE=BEU
RUN_TAMPERS=0
RUN_CRAWL=0
MAX_CRAWL_DEPTH=1
MAX_CRAWL_URLS=100

# Recursos desligados
RUN_ENUM=0
RUN_DUMP=0
ALLOW_METADATA_ENUMERATION=NO
ALLOW_LOCAL_BLIND_XSS=NO

# Timeouts conservadores
HTTP_TIMEOUT=20
MAX_JOB_SECONDS=1800

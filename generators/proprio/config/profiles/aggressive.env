# =============================================================================
# profiles/aggressive.env — alto volume para LABORATÓRIO ISOLADO e descartável.
# Exige, além de AUTHORIZED_SECURITY_TESTING=YES, o reforço DANGEROUS_ACK=YES.
# Continua respeitando: escopo, limites globais, sem pós-exploração, sem
# ações destrutivas e sem callback externo.
# =============================================================================
PROFILE_NAME=aggressive

MAX_PARALLEL_JOBS=4
THREADS=8
REQUEST_RATE=0
DELAY_MS=0

# Ampla cobertura de detecção (não ativa pós-exploração/escrita remota)
SQLMAP_LEVEL=5
SQLMAP_RISK=3
SQLMAP_TECHNIQUE=BEUSTQ
RUN_TAMPERS=1
RUN_ALL_DBMS_TAMPERS=1
RUN_CRAWL=1
MAX_CRAWL_DEPTH=3
MAX_CRAWL_URLS=5000

# Enumeração de metadados só se explicitamente liberada; dump destrutivo proibido
RUN_ENUM=0
RUN_DUMP=0
ALLOW_METADATA_ENUMERATION=NO
ALLOW_LOCAL_BLIND_XSS=NO

HTTP_TIMEOUT=30
MAX_JOB_SECONDS=7200
MAX_RUN_SECONDS=28800

# =============================================================================
# config/defaults.env — valores padrão para TODAS as execuções.
# Ordem de carga (o último vence):
#   defaults.env  ->  profiles/<PROFILE>.env  ->  .env  ->  variáveis de ambiente
# Este arquivo é versionado. Não coloque segredos aqui.
# =============================================================================

# --- Identificação -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text          # text | jsonl

# --- Modos de operação -------------------------------------------------------
DRY_RUN=0                # 1 = imprime comandos (mascarados) e NÃO executa
PRINT_COMMANDS=0         # 1 = também salva os comandos reproduzíveis em meta/

# --- Concorrência e limites globais (todos configuráveis) --------------------
MAX_PARALLEL_JOBS=4
MAX_REQUESTS_PER_JOB=50000
MAX_TOTAL_REQUESTS=500000
MAX_JOB_SECONDS=7200
MAX_RUN_SECONDS=28800
MAX_CRAWL_DEPTH=5
MAX_CRAWL_URLS=10000
MIN_FREE_DISK_GB=10
REQUEST_RATE=0           # 0 = usa o padrão da ferramenta; >0 = req/s
DELAY_MS=0

# --- Rede / HTTP -------------------------------------------------------------
HTTP_TIMEOUT=30
RETRIES=3
FOLLOW_REDIRECTS=0       # nunca seguir para fora do escopo

# --- Descoberta ffuf ---------------------------------------------------------
# O ffuf fica restrito a descoberta de caminhos por padrao. SQLi e XSS sao
# fases posteriores controladas pelo run-all, em janelas independentes.
RUN_FFUF_PATHS=1
RUN_FFUF_PARAMETERS=0
RUN_FFUF_VALUES=0
RUN_FFUF_HEADERS=0
RUN_FFUF_COOKIES=0
RUN_FFUF_FORM=0
RUN_FFUF_JSON=0
RUN_FFUF_SQLI=0
RUN_FFUF_XSS=0
RUN_FFUF_METHODS=0
RUN_FFUF_CONTENT_TYPES=0
RUN_FFUF_COMBINED=0

# --- Amostragem / rastreabilidade --------------------------------------------
ENABLE_SAMPLE_HEADERS=0  # 1 = injeta X-Research-Sample-ID / X-Research-Run-ID

# --- Enumeração (desabilitada por padrão; só laboratório) --------------------
ALLOW_METADATA_ENUMERATION=NO

# --- User-Agent (fixed = rotulável; random = treinável; mixed = alterna) -----
# Fixo em um User-Agent de navegador real (Chrome) para TODAS as ferramentas.
UA_MODE=fixed
USER_AGENT='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36'
